[
  {"id":"H1","scale":"hexaco","dimension":"honesty_humility","facet":"sincerity","reverse":false,"text":"我倾向于坦诚表达真实想法，即使不一定讨好他人。","source":"IPIP-HEXACO adapted"},
  {"id":"H2","scale":"hexaco","dimension":"honesty_humility","facet":"fairness","reverse":false,"text":"即使没人发现，我也不会占制度漏洞的便宜。","source":"IPIP-HEXACO adapted"},
  {"id":"H3","scale":"hexaco","dimension":"honesty_humility","facet":"greed_avoidance","reverse":true,"text":"如果有机会，我会追求比他人更多的特权。","source":"IPIP-HEXACO adapted"},
  {"id":"H4","scale":"hexaco","dimension":"honesty_humility","facet":"modesty","reverse":false,"text":"我不太喜欢炫耀自己的成就。","source":"IPIP-HEXACO adapted"},
  {"id":"H5","scale":"hexaco","dimension":"honesty_humility","facet":"sincerity","reverse":false,"text":"我会尽量避免说违心的话。","source":"IPIP-HEXACO adapted"},
  {"id":"H6","scale":"hexaco","dimension":"honesty_humility","facet":"fairness","reverse":false,"text":"在竞争中我仍然重视公平规则。","source":"IPIP-HEXACO adapted"},
  {"id":"H7","scale":"hexaco","dimension":"honesty_humility","facet":"greed_avoidance","reverse":true,"text":"我希望通过财富和地位来证明自己更重要。","source":"IPIP-HEXACO adapted"},
  {"id":"H8","scale":"hexaco","dimension":"honesty_humility","facet":"modesty","reverse":false,"text":"被夸奖时我通常会把功劳分给团队。","source":"IPIP-HEXACO adapted"},
  {"id":"H9","scale":"hexaco","dimension":"honesty_humility","facet":"sincerity","reverse":false,"text":"我不会为了短期利益故意误导别人。","source":"IPIP-HEXACO adapted"},
  {"id":"H10","scale":"hexaco","dimension":"honesty_humility","facet":"fairness","reverse":false,"text":"我反感通过不正当手段获得好处。","source":"IPIP-HEXACO adapted"},

  {"id":"E1","scale":"hexaco","dimension":"emotionality","facet":"fearfulness","reverse":false,"text":"面对不确定风险时我会明显紧张。","source":"IPIP-HEXACO adapted"},
  {"id":"E2","scale":"hexaco","dimension":"emotionality","facet":"anxiety","reverse":false,"text":"压力大时我容易反复担心最坏结果。","source":"IPIP-HEXACO adapted"},
  {"id":"E3","scale":"hexaco","dimension":"emotionality","facet":"dependence","reverse":false,"text":"在困难时我希望得到可靠支持。","source":"IPIP-HEXACO adapted"},
  {"id":"E4","scale":"hexaco","dimension":"emotionality","facet":"sentimentality","reverse":false,"text":"我很容易被亲密关系中的细节打动。","source":"IPIP-HEXACO adapted"},
  {"id":"E5","scale":"hexaco","dimension":"emotionality","facet":"fearfulness","reverse":false,"text":"突发状况会让我短时间失去冷静。","source":"IPIP-HEXACO adapted"},
  {"id":"E6","scale":"hexaco","dimension":"emotionality","facet":"anxiety","reverse":false,"text":"我经常提前为可能的失误做心理准备。","source":"IPIP-HEXACO adapted"},
  {"id":"E7","scale":"hexaco","dimension":"emotionality","facet":"dependence","reverse":true,"text":"即使情绪很差，我也不会向人求助。","source":"IPIP-HEXACO adapted"},
  {"id":"E8","scale":"hexaco","dimension":"emotionality","facet":"sentimentality","reverse":false,"text":"我会珍惜与重要他人的情感联结。","source":"IPIP-HEXACO adapted"},
  {"id":"E9","scale":"hexaco","dimension":"emotionality","facet":"fearfulness","reverse":true,"text":"我几乎从不因风险而担忧。","source":"IPIP-HEXACO adapted"},
  {"id":"E10","scale":"hexaco","dimension":"emotionality","facet":"anxiety","reverse":false,"text":"关键节点时我会担心自己表现不够好。","source":"IPIP-HEXACO adapted"},

  {"id":"X1","scale":"hexaco","dimension":"extraversion","facet":"social_self_esteem","reverse":false,"text":"在社交场合我通常表现得自信。","source":"IPIP-HEXACO adapted"},
  {"id":"X2","scale":"hexaco","dimension":"extraversion","facet":"social_boldness","reverse":false,"text":"我愿意主动认识新朋友或合作方。","source":"IPIP-HEXACO adapted"},
  {"id":"X3","scale":"hexaco","dimension":"extraversion","facet":"sociability","reverse":false,"text":"长时间独处后我会想找人交流。","source":"IPIP-HEXACO adapted"},
  {"id":"X4","scale":"hexaco","dimension":"extraversion","facet":"liveliness","reverse":false,"text":"我常给团队带来积极和活跃气氛。","source":"IPIP-HEXACO adapted"},
  {"id":"X5","scale":"hexaco","dimension":"extraversion","facet":"social_self_esteem","reverse":true,"text":"在众人面前表达观点让我不自在。","source":"IPIP-HEXACO adapted"},
  {"id":"X6","scale":"hexaco","dimension":"extraversion","facet":"social_boldness","reverse":true,"text":"我倾向避免成为讨论焦点。","source":"IPIP-HEXACO adapted"},
  {"id":"X7","scale":"hexaco","dimension":"extraversion","facet":"sociability","reverse":false,"text":"与人共事会让我更有动力。","source":"IPIP-HEXACO adapted"},
  {"id":"X8","scale":"hexaco","dimension":"extraversion","facet":"liveliness","reverse":false,"text":"我说话通常富有感染力。","source":"IPIP-HEXACO adapted"},
  {"id":"X9","scale":"hexaco","dimension":"extraversion","facet":"social_self_esteem","reverse":false,"text":"被多人关注时我仍能保持自然。","source":"IPIP-HEXACO adapted"},
  {"id":"X10","scale":"hexaco","dimension":"extraversion","facet":"sociability","reverse":true,"text":"我更喜欢尽量减少不必要的社交互动。","source":"IPIP-HEXACO adapted"},

  {"id":"A1","scale":"hexaco","dimension":"agreeableness","facet":"forgiveness","reverse":false,"text":"别人冒犯我后，我通常能较快释怀。","source":"IPIP-HEXACO adapted"},
  {"id":"A2","scale":"hexaco","dimension":"agreeableness","facet":"gentleness","reverse":false,"text":"我会尽量用温和方式表达不同意见。","source":"IPIP-HEXACO adapted"},
  {"id":"A3","scale":"hexaco","dimension":"agreeableness","facet":"flexibility","reverse":false,"text":"冲突时我愿意寻找双方都能接受的方案。","source":"IPIP-HEXACO adapted"},
  {"id":"A4","scale":"hexaco","dimension":"agreeableness","facet":"patience","reverse":false,"text":"遇到低效沟通时我仍能保持耐心。","source":"IPIP-HEXACO adapted"},
  {"id":"A5","scale":"hexaco","dimension":"agreeableness","facet":"forgiveness","reverse":true,"text":"别人伤害我后我会长期记着这件事。","source":"IPIP-HEXACO adapted"},
  {"id":"A6","scale":"hexaco","dimension":"agreeableness","facet":"gentleness","reverse":true,"text":"辩论时我容易变得尖锐和苛刻。","source":"IPIP-HEXACO adapted"},
  {"id":"A7","scale":"hexaco","dimension":"agreeableness","facet":"flexibility","reverse":true,"text":"我常坚持己见，不愿妥协。","source":"IPIP-HEXACO adapted"},
  {"id":"A8","scale":"hexaco","dimension":"agreeableness","facet":"patience","reverse":true,"text":"我很难容忍他人反复犯同样错误。","source":"IPIP-HEXACO adapted"},
  {"id":"A9","scale":"hexaco","dimension":"agreeableness","facet":"gentleness","reverse":false,"text":"即便生气我也会控制语气。","source":"IPIP-HEXACO adapted"},
  {"id":"A10","scale":"hexaco","dimension":"agreeableness","facet":"forgiveness","reverse":false,"text":"我愿意给真诚道歉的人第二次机会。","source":"IPIP-HEXACO adapted"},

  {"id":"C1","scale":"hexaco","dimension":"conscientiousness","facet":"organization","reverse":false,"text":"我会把任务分解并安排明确优先级。","source":"IPIP-HEXACO adapted"},
  {"id":"C2","scale":"hexaco","dimension":"conscientiousness","facet":"diligence","reverse":false,"text":"即使困难，我也会持续推进关键工作。","source":"IPIP-HEXACO adapted"},
  {"id":"C3","scale":"hexaco","dimension":"conscientiousness","facet":"perfectionism","reverse":false,"text":"我会反复检查工作的细节质量。","source":"IPIP-HEXACO adapted"},
  {"id":"C4","scale":"hexaco","dimension":"conscientiousness","facet":"prudence","reverse":false,"text":"做重要决定前我会先评估风险。","source":"IPIP-HEXACO adapted"},
  {"id":"C5","scale":"hexaco","dimension":"conscientiousness","facet":"organization","reverse":true,"text":"我的工作环境常常混乱难找东西。","source":"IPIP-HEXACO adapted"},
  {"id":"C6","scale":"hexaco","dimension":"conscientiousness","facet":"diligence","reverse":true,"text":"我经常拖到最后一刻才开始任务。","source":"IPIP-HEXACO adapted"},
  {"id":"C7","scale":"hexaco","dimension":"conscientiousness","facet":"perfectionism","reverse":false,"text":"我会主动设定清晰的完成标准。","source":"IPIP-HEXACO adapted"},
  {"id":"C8","scale":"hexaco","dimension":"conscientiousness","facet":"prudence","reverse":true,"text":"我常在冲动下快速拍板重要事情。","source":"IPIP-HEXACO adapted"},
  {"id":"C9","scale":"hexaco","dimension":"conscientiousness","facet":"diligence","reverse":false,"text":"我能在无人监督时保持执行力。","source":"IPIP-HEXACO adapted"},
  {"id":"C10","scale":"hexaco","dimension":"conscientiousness","facet":"organization","reverse":false,"text":"我会通过工具追踪进度与截止时间。","source":"IPIP-HEXACO adapted"},

  {"id":"O1","scale":"hexaco","dimension":"openness","facet":"aesthetic_appreciation","reverse":false,"text":"我容易被有美感的设计或艺术打动。","source":"IPIP-HEXACO adapted"},
  {"id":"O2","scale":"hexaco","dimension":"openness","facet":"inquisitiveness","reverse":false,"text":"我经常主动学习陌生领域的新知识。","source":"IPIP-HEXACO adapted"},
  {"id":"O3","scale":"hexaco","dimension":"openness","facet":"creativity","reverse":false,"text":"我喜欢尝试非常规的新方法。","source":"IPIP-HEXACO adapted"},
  {"id":"O4","scale":"hexaco","dimension":"openness","facet":"unconventionality","reverse":false,"text":"我愿意挑战传统做法，只要更有效。","source":"IPIP-HEXACO adapted"},
  {"id":"O5","scale":"hexaco","dimension":"openness","facet":"inquisitiveness","reverse":false,"text":"我经常思考人生的意义和长远问题。","source":"IPIP-HEXACO adapted"},
  {"id":"O6","scale":"hexaco","dimension":"openness","facet":"creativity","reverse":true,"text":"我更偏好沿用现成方案而不是创新。","source":"IPIP-HEXACO adapted"},
  {"id":"O7","scale":"hexaco","dimension":"openness","facet":"aesthetic_appreciation","reverse":true,"text":"审美和体验细节对我不太重要。","source":"IPIP-HEXACO adapted"},
  {"id":"O8","scale":"hexaco","dimension":"openness","facet":"unconventionality","reverse":true,"text":"我通常排斥与主流不同的观点。","source":"IPIP-HEXACO adapted"},
  {"id":"O9","scale":"hexaco","dimension":"openness","facet":"inquisitiveness","reverse":false,"text":"我对复杂系统背后的原理很好奇。","source":"IPIP-HEXACO adapted"},
  {"id":"O10","scale":"hexaco","dimension":"openness","facet":"creativity","reverse":false,"text":"我乐于把不同领域的想法进行跨界组合。","source":"IPIP-HEXACO adapted"}
