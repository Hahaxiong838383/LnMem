<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lnmem.studio-nightly-train</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/fu-121/lnmem-poc &amp;&amp; ./scripts/studio_nightly_train.sh</string>
    </array>

    <!-- 每天 03:00 跑（ADR-029 Q2=A） -->
